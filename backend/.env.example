# Скопируйте этот файл в .env и подставьте свои значения.
# Сам .env в репозиторий не коммитится (см. .gitignore).

# Строка подключения к PostgreSQL:
# postgresql+psycopg2://<пользователь>:<пароль>@<хост>:<порт>/<база>
DATABASE_URL=postgresql+psycopg2://book_exchange_user:CHANGE_ME@localhost:5432/book_exchange

# development | production — влияет на подробность логов и сообщений об ошибках
APP_ENV=development

# Разрешённый источник для CORS (адрес, с которого frontend обращается к API)
CORS_ORIGIN=http://localhost:5173
